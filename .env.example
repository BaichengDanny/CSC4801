# Settings are read from the process environment, not automatically from this file.
# Generate a local secret; never commit a real value.
# SECRET_KEY=replace-with-a-random-local-secret
# DATABASE=/absolute/path/to/local-demo.sqlite3
# HOST=127.0.0.1
# PORT=8080
# Set to 1 only when serving through HTTPS. Leave 0 for the local HTTP demo.
# COOKIE_SECURE=0
